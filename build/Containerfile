# syntax=docker/dockerfile:1

ARG NODE_IMAGE=docker.io/library/node:24
ARG NGINX_IMAGE=docker.io/nginxinc/nginx-unprivileged:mainline-trixie

FROM ${NODE_IMAGE} AS build

WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# shown in the app (logo tooltip, welcome page), passed by build.sh
ARG HYPERBOREA_VERSION=dev
RUN npm run build

FROM ${NGINX_IMAGE} AS final

COPY build/nginx.conf /etc/nginx/conf.d/default.conf
COPY build/security-headers.conf /etc/nginx/security-headers.conf
# scripts in /docker-entrypoint.d run on container start, before nginx
COPY --chmod=755 build/30-write-runtime-config.sh /docker-entrypoint.d/30-write-runtime-config.sh
COPY --from=build --chown=nginx /src/dist /usr/share/nginx/html

EXPOSE 8080
